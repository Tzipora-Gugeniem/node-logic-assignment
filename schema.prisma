

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//Enums 
//הגדרת סטטוס משחק
enum GameStatus {
  Waiting
  Started
  Finished
}
//הגדרת תפקיד שחקן
enum PlayerRole {
  Admin
  Player
  Spectator
}

//models
// User
model User {
  id          Int               @id @default(autoincrement())
  email       String            @unique
  name        String?
  participations GameParticipant[]
  createdAt   DateTime          @default(now())
}

// Game
model Game {
  id            Int               @id @default(autoincrement())
  name          String
  status        GameStatus        @default(Waiting)
  // optional max participants
  maxParticipants Int?
  participants  GameParticipant[]
  createdAt     DateTime          @default(now())
}

// GameParticipant
model GameParticipant {
  id        Int        @id @default(autoincrement())
  userId    Int
  gameId    Int
  score     Int        @default(0)
  role      PlayerRole @default(Player)
  joinedAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id])
  game Game @relation(fields: [gameId], references: [id])

  @@unique([userId, gameId], name: "userId_gameId")
}